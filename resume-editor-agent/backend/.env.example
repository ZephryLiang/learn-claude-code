# ── Required ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── Optional ────────────────────────────────────────────────
# Model to use (default: deepseek-v4-flash)
MODEL_ID=deepseek-v4-flash

# Server port (default: 8001)
PORT=8001
